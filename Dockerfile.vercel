FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY resources ./resources
COPY vite.config.js tailwind.config.js postcss.config.js ./
RUN npm run build

FROM dunglas/frankenphp:1-php8.3-alpine AS base

WORKDIR /app

RUN install-php-extensions curl dom gd intl mbstring opcache pdo_mysql pdo_pgsql zip

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    PRODUCT_IMAGE_STORAGE=vercel_blob \
    PORT=80

FROM base AS build

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .
RUN composer dump-autoload --no-dev --optimize --no-scripts \
    && php artisan package:discover --ansi \
    && php artisan storage:link

FROM base AS runtime

COPY --from=build /app /app
COPY --from=assets /app/public/build /app/public/build
COPY Caddyfile /etc/caddy/Caddyfile

RUN mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions \
    storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
